rules_version = '2';
// Multi-utente: ognuno ha il proprio spazio privato sotto
// users/{uid}/... (parole chiave, bandi trovati, stato dell'ultima
// scansione, richieste di reset). L'elenco delle fonti monitorate
// (sources) resta invece CONDIVISO tra tutti gli utenti registrati: è un
// catalogo comune di pagine istituzionali, gestito insieme.
//
// Registrazione libera: chiunque abbia il link può creare un proprio
// account (email/password, vedi Firebase Authentication → Sign-in
// method → Email/Password) e da quel momento vede/gestisce SOLO i propri
// dati. Nessuna lettura pubblica senza login: a differenza della vecchia
// versione (un solo account condiviso, PIN per scrivere), ora anche
// consultare i bandi richiede di essere autenticati con un proprio
// account, perché i bandi sono privati per ciascun utente.
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento creato dal client al momento della registrazione
    // (email, data di creazione): serve solo a scan.py per sapere quali
    // utenti sono registrati (elenco su cui girare la scansione). Ogni
    // utente può leggere/scrivere SOLO il proprio.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Parole chiave e frequenza di scansione: private, solo il
    // proprietario dell'account può leggerle o modificarle.
    match /users/{uid}/config/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Stato dell'ultima scansione DI QUESTO UTENTE (parole chiave sue):
    // leggibile solo da lui, scrivibile SOLO dallo script che gira su
    // GitHub Actions (Admin SDK, ignora queste regole). Nessun client
    // web può scriverci.
    match /users/{uid}/meta/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Bandi trovati per QUESTO UTENTE: stessa logica, sola lettura dal
    // client, e solo per il proprietario.
    match /users/{uid}/calls/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Il pulsante "Ricomincia da zero" nell'app scrive qui per chiedere
    // allo scraper di svuotare, al prossimo giro, SOLO i bandi trovati
    // di questo utente (non le fonti condivise, non gli altri utenti).
    match /users/{uid}/admin/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Elenco CONDIVISO delle pagine monitorate: chiunque abbia un
    // account può leggerlo, aggiungere o togliere una fonte (è un
    // catalogo comune gestito insieme, senza bisogno di un
    // "amministratore" speciale) — deciso esplicitamente così: vedi la
    // conversazione con l'utente in cui ha preferito questa opzione a un
    // elenco privato per ciascuno. Lo scraper le legge tramite la Admin
    // SDK, che ignora comunque queste regole.
    match /sources/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Stato CONDIVISO delle fonti (raggiungibilità di ciascuna pagina,
    // hash del contenuto per rilevare cambiamenti): scritto una sola
    // volta per scansione dallo script (Admin SDK), letto da chiunque
    // sia autenticato. Non contiene nulla di specifico di un utente.
    match /meta/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
