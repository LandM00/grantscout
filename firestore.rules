rules_version = '2';
// NOTA: la lettura resta pubblica per chiunque abbia il link (nessun
// login per consultare i bandi). La scrittura su config/admin/sources
// invece richiede di essere autenticati: l'app chiede un codice numerico
// (vedi SETUP.md, sezione "Proteggi le modifiche con un codice di
// accesso") che internamente fa login con un account Firebase dedicato.
// Chi non inserisce il codice giusto non può modificare nulla.
service cloud.firestore {
  match /databases/{database}/documents {

    // Chiunque abbia il link dell'app può leggere le impostazioni; per
    // modificarle (parole chiave, frequenza) serve il codice di accesso.
    match /config/main {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Stato dell'ultima scansione: leggibile da tutti, scrivibile SOLO dallo
    // script che gira su GitHub Actions (usa la Admin SDK, che ignora queste
    // regole). Nessun client web può scriverci.
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Elenco dei bandi trovati: stessa logica, sola lettura dal client.
    match /calls/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Il pulsante "Ricomincia da zero" nell'app scrive qui per chiedere
    // allo scraper di svuotare i bandi trovati al prossimo giro. Anche
    // questo richiede il codice di accesso.
    match /admin/reset {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Elenco delle pagine monitorate: leggibile da tutti; per aggiungere o
    // rimuovere fonti serve il codice di accesso. Lo scraper le legge
    // tramite la Admin SDK, che ignora comunque queste regole.
    match /sources/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
